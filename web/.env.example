# Server-only BFF environment variables (NEVER prefix secrets with NEXT_PUBLIC_)
AIOS_API_BASE_URL=http://127.0.0.1:8760
# Optional split-upstream override for /v1/assurance/* (e.g. http://127.0.0.1:8761).
# Useful when the primary API runs AIOS_WORKBENCH_PLANNER=pydantic-ai alongside a
# dedicated local Assurance backend sharing the same state directory and session key.
# Leave unset/empty to route /v1/assurance/* to AIOS_API_BASE_URL.
# AIOS_ASSURANCE_API_BASE_URL=http://127.0.0.1:8761
AIOS_BROWSER_ORIGIN=http://localhost:3000

# Controlled local demo authentication (enable ONLY in local/demo environments)
AIOS_ENABLE_DEMO_AUTH=0
# Must match FastAPI AIOS_DEMO_SECRET (>= 32 chars, no period ".")
AIOS_DEMO_SECRET=
# Optional password for POST /api/auth/login when AIOS_ENABLE_DEMO_AUTH=1 (defaults to aios2026)
# NEVER prefix with NEXT_PUBLIC_
# AIOS_DEMO_LOGIN_PASSWORD=aios2026

# Set to 1 in production OIDC deployments so /login shows the enterprise SSO button
AIOS_OIDC_LOGIN_ENABLED=0

# =============================================================================
# Optional Server-Side MCP Calendar & Zoom Integrations (Server-Only, Zero Keys Needed by Default)
# Without these, AIOS runs live internal calendar storage + real RFC 5545/7986 .ics export.
# =============================================================================

# Google Calendar MCP (@cocal/google-calendar-mcp Streamable HTTP)
# AIOS_MCP_GOOGLE_CALENDAR_URL=http://127.0.0.1:3101/mcp
# AIOS_MCP_GOOGLE_CALENDAR_TOKEN=
# AIOS_MCP_GOOGLE_CALENDAR_ID=primary
# AIOS_MCP_GOOGLE_CALENDAR_TOOL=create-event

# Apple iCloud Calendar MCP (caldav-mcp --http or supergateway bridge)
# AIOS_MCP_ICLOUD_CALENDAR_URL=http://127.0.0.1:3102/mcp
# AIOS_MCP_ICLOUD_CALENDAR_TOKEN=
# AIOS_MCP_ICLOUD_CALENDAR_TOOL=create_event

# Outlook / Microsoft 365 Calendar MCP (@softeria/ms-365-mcp-server --http)
# AIOS_MCP_OUTLOOK_CALENDAR_URL=http://127.0.0.1:3103/mcp
# AIOS_MCP_OUTLOOK_CALENDAR_TOKEN=
# AIOS_MCP_OUTLOOK_CALENDAR_TOOL=create-calendar-event

# Zoom Video Meetings — Option A: Streamable HTTP Zoom MCP Server
# AIOS_MCP_ZOOM_URL=http://127.0.0.1:3104/mcp
# AIOS_MCP_ZOOM_TOKEN=
# AIOS_MCP_ZOOM_TOOL=create_meeting

# Zoom Video Meetings — Option B: Direct Zoom Server-to-Server OAuth (Free Zoom Marketplace App)
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_HOST_USER_ID=me
