{
  "name": "theodic-email-mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone production Streamable HTTP & stdio Email MCP server for Theodic Enterprise Workbench",
  "main": "./dist/index.js",
  "bin": {
    "theodic-email-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "nodemailer": "^7.0.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
