# ==============================================================================
# IntegrAI Daily SQLite Hot Backup Timer
# ==============================================================================
# Triggers `aios-sqlite-backup.service` daily at 03:15 UTC (11:15 HKT) with
# up to 10 minutes randomized delay and catch-up persistence across reboots.
# ==============================================================================

[Unit]
Description=Daily IntegrAI SQLite Hot Backup Timer

[Timer]
OnCalendar=*-*-* 03:15:00 UTC
RandomizedDelaySec=10m
Persistent=true
Unit=aios-sqlite-backup.service

[Install]
WantedBy=timers.target
